# Applique les migrations Django à chaque déploiement, avant que la nouvelle version ne serve le
# trafic (sinon, ex. internet_credits : `/api/sync/pull/` répond 500 tant que ses tables n'existent
# pas). `leader_only` : une seule instance les exécute quand l'environnement en compte plusieurs.
container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py migrate --noinput"
    leader_only: true
